\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Validation PSNR against filter strength, measured on 24 validation crops. Both curves peak inside the grid, BM3D at 0.20 and non-local means at 0.08, so neither result is limited by where we stopped searching. Non-local means drops off quickly past its peak, which is the over-smoothing expected once it starts averaging patches that are not really similar.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:calib}{{1}{4}{Validation PSNR against filter strength, measured on 24 validation crops. Both curves peak inside the grid, BM3D at 0.20 and non-local means at 0.08, so neither result is limited by where we stopped searching. Non-local means drops off quickly past its peak, which is the over-smoothing expected once it starts averaging patches that are not really similar}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One test crop, shot at ISO 100 in low light. BM3D removes the grain while keeping the lettering on the box readable. Non-local means removes the grain too but blurs the same detail, which is where its 1.72\,dB deficit comes from.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:qual}{{2}{4}{One test crop, shot at ISO 100 in low light. BM3D removes the grain while keeping the lettering on the box readable. Non-local means removes the grain too but blurs the same detail, which is where its 1.72\,dB deficit comes from}{figure.2}{}}
